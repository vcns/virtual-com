<Project>
  <!--
    The Windows SDK and WDK come from NuGet (see packages.config), so builds don't depend on whatever kits are
    installed on the machine. Restore with:  nuget restore packages.config -PackagesDirectory packages
  -->
  <PropertyGroup>
    <WdkNuGetVersion>10.0.28000.2526</WdkNuGetVersion>
    <WdkSdkVersion>10.0.28000.0</WdkSdkVersion>
    <KitPackages>$(MSBuildThisFileDirectory)packages\</KitPackages>
    <SdkRoot>$(KitPackages)Microsoft.Windows.SDK.CPP.$(WdkNuGetVersion)\c\</SdkRoot>
    <SdkLibRoot>$(KitPackages)Microsoft.Windows.SDK.CPP.x64.$(WdkNuGetVersion)\c\</SdkLibRoot>
    <WdkRoot>$(KitPackages)Microsoft.Windows.WDK.x64.$(WdkNuGetVersion)\c\</WdkRoot>
    <SdkBin>$(SdkRoot)bin\$(WdkSdkVersion)\x64\</SdkBin>
    <WdkBin>$(WdkRoot)bin\$(WdkSdkVersion)\</WdkBin>
  </PropertyGroup>

  <!--
    The release version, shared by the driver and every program; a release is tagged v<VersionPrefix>. Builds add a
    fourth part, the CI run number (0 for a local build), so each CI build of the driver has a higher version than the
    one before and Windows takes it as an upgrade.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">$(GITHUB_RUN_NUMBER)</BuildNumber>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <FileVersion>$(VersionPrefix).$(BuildNumber)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$(BuildNumber)</AssemblyVersion>
  </PropertyGroup>
</Project>
