<?xml version="1.0" encoding="utf-8"?>
<!-- Single self-contained executable for 64-bit Windows 10/11. No .NET runtime needs to be installed on the target.
     dotnet publish src/vcombridge -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\..\out\publish\vcombridge\</PublishDir>
  </PropertyGroup>
</Project>
