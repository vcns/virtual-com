<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VcomBridge</RootNamespace>
    <AssemblyName>vcombridge</AssemblyName>
    <ApplicationIcon>Assets\vcombridge.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <Product>VCNS Virtual COM Bridge</Product>
    <Description>Bridges virtual COM ports to TCP</Description>
    <Company>VCNS Tech Ltd</Company>
    <Copyright>Copyright © 2026 VCNS Tech Ltd</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vcns.VirtualCom.Desktop\Vcns.VirtualCom.Desktop.csproj" />
  </ItemGroup>

</Project>
