<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Vcns.VirtualCom.Bridge</RootNamespace>
    <Description>Bridges VCNS virtual COM ports to TCP: profiles, sessions, single-session locking and port management.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vcns.VirtualCom.Desktop" />
    <InternalsVisibleTo Include="Vcns.VirtualCom.Bridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vcns.VirtualCom\Vcns.VirtualCom.csproj" />
  </ItemGroup>

  <!--
    The VCNS virtual COM driver package is embedded when a signed build of it is available, so applications built on
    this library can install the driver themselves. Point VirtualComPackageDir at a signed package (vcnsvcom.inf, .dll,
    .cat); by default it is this repository's own driver build output. Without it, ports can still be created with com0com.
  -->
  <PropertyGroup>
    <VirtualComPackageDir Condition="'$(VirtualComPackageDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\Release\package\</VirtualComPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(VirtualComPackageDir)vcnsvcom.cat')">
    <EmbeddedResource Include="$(VirtualComPackageDir)vcnsvcom.inf;$(VirtualComPackageDir)vcnsvcom.dll;$(VirtualComPackageDir)vcnsvcom.cat"
                      LogicalName="VirtualComDriver/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
